<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="my_mall.mapper.SeckillGoodsMapper">

    <resultMap id="BaseResultMap" type="my_mall.entity.po.SeckillGoods">
        <id column="id" property="id"/>
        <result column="goods_id" property="goodsId"/>
        <result column="goods_name" property="goodsName"/>
        <result column="seckill_price" property="seckillPrice"/>
        <result column="stock_count" property="stockCount"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO my_mall.seckill_goods
            (goods_id, seckill_price, stock_count, start_time, end_time, status)
        VALUES
            (#{goodsId}, #{seckillPrice}, #{stockCount}, #{startTime}, #{endTime}, #{status})
    </insert>

    <update id="update">
        UPDATE seckill_goods
        <set>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="seckillPrice != null">seckill_price = #{seckillPrice},</if>
            <if test="stockCount != null">stock_count = #{stockCount},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM my_mall.seckill_goods WHERE id = #{id}
    </delete>

    <select id="getById" resultMap="BaseResultMap">
        SELECT * FROM my_mall.seckill_goods WHERE id = #{id}
    </select>

    <select id="pageQuery" resultMap="BaseResultMap">
        SELECT sg.*, g.name AS goods_name FROM my_mall.seckill_goods sg
        LEFT JOIN my_mall.goods g ON sg.goods_id = g.id
        <where>
            <if test="goodsName != null and goodsName != ''">
                AND g.name LIKE CONCAT('%', #{goodsName}, '%')
            </if>
            <if test="status != null">
                AND sg.status = #{status}
            </if>
            <if test="startTime != null">
                AND sg.start_time >= #{startTimeFrom}
            </if>
            <if test="endTime != null">
                AND sg.start_time &lt;= #{startTimeTo}
            </if>
        </where>
    </select>

    <update id="updateStatus">
        UPDATE my_mall.seckill_goods SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="deleteByGoodsId">
        DELETE FROM my_mall.seckill_goods WHERE goods_id = #{goodsId}
    </delete>
</mapper>