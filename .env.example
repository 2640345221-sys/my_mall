# 复制此文件为 .env，填入真实值后 `docker compose up -d`
# .env 不可提交到 git；变量名需与 docker-compose.yml 中 ${VAR} 对应

# 数据库（mysql 容器 root 密码 + app 连接密码）
DB_PASSWORD=你的数据库密码

# RabbitMQ（默认 guest/guest）
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT 签名密钥（app 容器，需 >=32 位避免 HS256 报错）
JWT_ADMIN_KEY=你的管理端密钥
JWT_USER_KEY=你的用户端密钥

# 阿里云 OSS（app 容器）
OSS_KEY_ID=你的AK
OSS_KEY_SECRET=你的SK
OSS_BUCKET=你的bucket名
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
